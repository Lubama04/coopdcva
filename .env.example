# Copier ce fichier en .env.local pour le développement. Ne jamais committer de vraie clé.

# Clé API Resend (https://resend.com/api-keys), permission « Sending access » suffit.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les messages du formulaire (par défaut : l'e-mail du site dans src/lib/site.ts).
CONTACT_TO_EMAIL=coop.dcva@gmail.com

# Expéditeur. Sans domaine vérifié chez Resend, seule l'adresse de test fonctionne
# et elle n'envoie qu'à l'e-mail du compte Resend.
CONTACT_FROM_EMAIL="Site COOP-DCVA <onboarding@resend.dev>"

# URL publique du site (canonique, sitemap). Facultatif sur Vercel.
# NEXT_PUBLIC_SITE_URL=https://coop-dcva-site.vercel.app
